{
  "notes": "Extracted from Moving Papa RSAs. Each slot has a ROLE; the AI fills the role for the specific service/city. Keep KWI and LOCATION headlines literal.",
  "limits": {
    "headline_max_chars": 30,
    "description_max_chars": 90,
    "min_headlines": 5,
    "min_descriptions": 2,
    "target_headlines": 15,
    "target_descriptions": 4
  },
  "headlines": [
    {
      "role": "keyword_insertion_brand_fallback",
      "template": "{KeyWord:<BusinessName>}",
      "literal": true
    },
    {
      "role": "location_insertion",
      "template": "<ServiceNoun> Servicing {LOCATION(City):Your Area}",
      "literal": true
    },
